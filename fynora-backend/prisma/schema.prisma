generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// @model Company
/// Centraliza o Tenant da empresa (MEI).
model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique // CPF (11 dígitos) ou CNPJ (14 dígitos)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  users        User[]
  customers    Customer[]
  transactions Transaction[]
  projects     Project[]
  insights     Insight[]

  @@map("companies")
}

/// @model User
/// Credenciais e perfil do usuário.
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Hash criptografado (bcrypt)
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("users")
}

/// @model Customer
/// Cadastro de clientes do MEI.
model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  transactions Transaction[]
  projects     Project[]

  @@index([companyId])
  @@map("customers")
}

enum TransactionType {
  IN  // Receita / Entrada de caixa
  OUT // Despesa / Saída de caixa
}

/// @model Transaction
/// [SINGLE LEDGER] Registro unificado de movimentações financeiras.
model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType // Natureza matemática (IN / OUT)
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime        // Data de competência
  category    String?
  isBusiness  Boolean         @default(true) // true = Gasto Empresa (PJ) | false = Gasto Pessoal (PF)
  companyId   String          @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String?         @map("customer_id")
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at") // Soft delete fiscal

  @@index([companyId])
  @@index([companyId, date, type]) // Índice composto para performance do Dashboard
  @@map("transactions")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// @model Project
/// Projetos/Serviços contratados por clientes.
model Project {
  id         String        @id @default(uuid())
  name       String
  status     ProjectStatus @default(PLANNED)
  companyId  String        @map("company_id")
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?       @map("customer_id")
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("projects")
}

/// @model Insight
/// Recomendações e alertas gerados pelo motor de IA.
model Insight {
  id        String   @id @default(uuid())
  type      String   // Ex: 'warning', 'tip', 'prediction'
  title     String
  content   String
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("insights")
}